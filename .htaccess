# Mecca Group — Apache configuration
RewriteEngine On

# ──────────────────────────────────────────────────────────────────────────
# HTTPS redirect (skip on localhost/dev)
# ──────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ──────────────────────────────────────────────────────────────────────────
# Custom error pages
# ──────────────────────────────────────────────────────────────────────────
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# ──────────────────────────────────────────────────────────────────────────
# Security headers
# ──────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS — forza HTTPS per 1 anno (rimuovi 'preload' finché non sottoposto a hstspreload.org)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # No clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # No MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer minimo cross-origin
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disabilita feature browser non utilizzate
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=()"

    # Cross-origin isolation moderata
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Nasconde la versione di Apache/PHP (richiede ServerTokens Prod a livello server)
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # CSP enforcing.
    # Sorgenti consentite:
    #   - script:  self + Google reCAPTCHA (www.google.com / www.gstatic.com)
    #   - style:   self + Google Fonts (richiede 'unsafe-inline' per i pochi style="..." inline nelle pagine)
    #   - font:    self + fonts.gstatic.com + data: (per i font in base64)
    #   - img:     self + data: + qualsiasi https (loghi partner)
    #   - frame:   Google (iframe Maps in contact.php + widget reCAPTCHA) + Instagram (post embed in homepage)
    #   - connect: self + Google (per la verify reCAPTCHA dal client)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; frame-src https://www.google.com https://www.instagram.com; connect-src 'self' https://www.google.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"
</IfModule>

# ──────────────────────────────────────────────────────────────────────────
# MIME types
# ──────────────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# ──────────────────────────────────────────────────────────────────────────
# Cache & compression
# ──────────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ──────────────────────────────────────────────────────────────────────────
# Hide sensitive files
# ──────────────────────────────────────────────────────────────────────────
<Files ".htaccess">
    Require all denied
</Files>

<Files ".env">
    Require all denied
</Files>

<Files ".env.example">
    Require all denied
</Files>

<Files ".gitignore">
    Require all denied
</Files>

<Files "*.log">
    Require all denied
</Files>

<Files "contact_info.txt">
    Require all denied
</Files>

<Files "iframes_homepage.txt">
    Require all denied
</Files>

<Files "composer.json">
    Require all denied
</Files>

<Files "composer.lock">
    Require all denied
</Files>

# Blocca l'intera directory cache (file di rate limiting, non devono essere serviti)
RewriteRule ^cache/ - [F,L]

# Blocca accesso a .git/ se finisse online per errore
RewriteRule ^\.git/ - [F,L]

# Disable directory browsing
Options -Indexes

# Disable server signature
ServerSignature Off
