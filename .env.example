# Mecca Group — Configurazione ambiente
# Copia questo file in `.env` e compila i valori reali.
# Il file `.env` non deve MAI essere committato.

# SMTP (Gmail con password app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="NoReply - MeccaGroup"

# Email destinatari del form contatti
CONTACT_TO_EMAIL=
CONTACT_TO_NAME="Mecca Group"
CONTACT_CC_EMAIL=

# Google reCAPTCHA v3
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
